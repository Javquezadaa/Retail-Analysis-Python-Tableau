   "source": [
    "##Step 2. Importing Data\n",
    "df = pd.read_pickle('/Users/javieraquezada/Desktop/Retail Analysis/02 Data/cleaned_sample.pkl')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "5b2f6584-594e-4663-acaf-cb9f1bc4806b",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Keeping only the numeric columns to be  clustered on\n",
    "numeric_cols = ['Age',               # customer demographics\n",
    "                'Total_Purchases',   # buying frequency\n",
    "                'Total_Amount',      # monetary value\n",
    "                'Ratings']           # satisfaction proxy\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "b865da20-384a-4694-9e00-5f789130533c",
   "metadata": {},
   "outputs": [],
   "source": [
    "scaled_data = df[numeric_cols].copy()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "70a85f95-c0a9-480a-bd31-de84218d0cc9",
   "metadata": {},
   "outputs": [],
   "source": [
    "##Dropping categoricals (Gender, Country, etc.) because k-means only works on numbers. \n",
    "##The four variables above capture recency–frequency–monetary style behaviour plus satisfaction.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "56f8de7a-92e5-4ec9-9772-64e4da5e1574",
   "metadata": {},
   "outputs": [],
   "source": [
    "## Data Standarization\n",
    "scaler = StandardScaler()\n",
    "X = scaler.fit_transform(scaled_data)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "bde168e7-2aa9-4c2c-a2c2-0487e0db61be",
   "metadata": {},
   "outputs": [],
   "source": [
    "## Standardization  will remove the influence of differing units (dollars vs. counts) for example."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
